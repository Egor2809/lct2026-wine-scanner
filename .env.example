# Скопировать в .env — .env в .gitignore, репозиторий открыт для экспертов.

# Путь к дампу каталога «Своё вино» (CSV).
CATALOG_PATH=data/catalog.csv

# Каталог с эталонными фотографиями позиций (если дамп ссылается на локальные файлы).
CATALOG_IMAGES_DIR=data/catalog_photos
# Превью этих фото для карточек UI (scripts/make_thumbnails.py), лежат в репозитории.
CATALOG_THUMBS_DIR=data/catalog_thumbs

# Куда build_index.py кладёт векторы и метаданные.
ARTIFACTS_DIR=artifacts

# Конфиг весов, порогов и маппинга колонок.
CONFIG_PATH=config/config.yaml

# Статика фронтенда, монтируется в корень.
FRONTEND_DIR=frontend

LOG_LEVEL=info
# Домены портала, которым можно звать API из браузера (через запятую).
CORS_ORIGINS=*

# Предел тела POST /scan в МБ: больше -> 413 до чтения тела (по Content-Length)
# или сразу по превышении (если тело идёт без Content-Length).
MAX_UPLOAD_MB=100
# Сколько /scan одновременно идут в модель (остальные ждут в очереди).
# На CPU параллельные прогоны делят ядра и тормозят друг друга; 0 — без предела.
SCAN_CONCURRENCY=2

# OCR этикетки: Yandex Vision OCR (API-ключ сервисного аккаунта с ролью
# ai.vision.user) и ID каталога Yandex Cloud. Ключ передаётся отдельно
# от репозитория. Пусто или ключ отклонён -> сервис всё равно стартует:
# на macOS читает текст локально (Apple Vision), на Linux/Windows
# распознаёт только по картинке (точность ниже, см. README).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Индекс: пусто — index.kind из config.yaml (numpy); pgvector — PostgreSQL заказчика.
INDEX_KIND=
# Только при pgvector: PostgreSQL с расширением vector.
# Пустая таблица на первом старте заполняется из artifacts/index.npz.
PGVECTOR_DSN=
PGVECTOR_TABLE=wine_vectors

# Порт на хосте для docker compose (внутри контейнера всегда 8080).
HOST_PORT=8080

# VLM-судья для офлайн-эксперимента scripts/eval_judge.py (OpenAI-совместимый
# API). Сервис /scan его не использует. Никогда не коммитить.
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=
